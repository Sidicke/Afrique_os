# ===== API =====
PORT=3000
NODE_ENV=development

# ===== Base de données (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platforme?schema=public"

# ===== JWT =====
# Access token : courte durée (15 min), envoyé dans Authorization: Bearer
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token : longue durée (7 jours), stocké en cookie httpOnly
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# Cookie refresh : Secure en production, SameSite strict, domaine éventuel
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ===== CORS =====
# Origine autorisée du frontend Next.js (séparer plusieurs origines par des virgules)
CORS_ORIGINS=http://localhost:3001

# ===== Rate limiting (@nestjs/throttler) =====
# Limite globale par IP : ttl en millisecondes, limit = nombre de requêtes
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ===== E-mail transactionnel (Resend) =====
# Sans RESEND_API_KEY, le backend fonctionne en DRY-RUN (aucun e-mail envoyé,
# log en console) — pratique en dev et pour les tests.
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse d'expédition : doit être un domaine VÉRIFIÉ chez Resend
# (https://resend.com/domains). ⚠️ onboarding@resend.dev (mode test) ne livre
# que vers la boîte de votre compte Resend — jamais vers vos clients.
MAIL_FROM=noreply@votre-domaine.com
MAIL_FROM_NAME=Plateforme

# ===== API =====
PORT=3000
NODE_ENV=development

# ===== Base de données (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platforme?schema=public"

# ===== JWT =====
# Access token : courte durée (15 min), envoyé dans Authorization: Bearer
# 🔑 Générer en prod : openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token : longue durée (7 jours), stocké en cookie httpOnly
# 🔑 Générer en prod : openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN=7d
# Cookie refresh : Secure en production, SameSite strict, domaine éventuel
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ===== Chiffrement de la Messagerie (AES-256-GCM) =====
# ⚠️  OBLIGATOIRE — l'application refuse de démarrer si cette variable est absente.
# 🔑 Générer : openssl rand -hex 32
MESSAGING_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ===== Authentification Sociale (Google OAuth) =====
# ⚠️  OBLIGATOIRE si la connexion Google est activée dans le frontend.
# Obtenir sur : https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ===== CORS =====
# Origine autorisée du frontend Next.js (séparer plusieurs origines par des virgules)
CORS_ORIGINS=http://localhost:3001

# ===== Rate limiting (@nestjs/throttler) =====
# Limite globale par IP : ttl en millisecondes, limit = nombre de requêtes
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ===== E-mails Transactionnels ZennShop (Architecture à 2 Canaux Pro) =====
# Sans RESEND_API_KEY ni SMTP, le backend fonctionne en DRY-RUN (aucun e-mail envoyé,
# log en console) — pratique en dev et pour les tests.
RESEND_API_KEY=
MAIL_FROM=noreply@zennshop.com
MAIL_FROM_NAME=ZennShop

# 1. Canal « Système & Compte » (OTP inscription, mot de passe oublié, sécurité compte)
MAIL_FROM_SYSTEM=compte@zennshop.com
MAIL_FROM_SYSTEM_NAME="ZennShop Sécurité"

# 2. Canal « Activités Plateforme » (Ventes validées, messages, objectifs atteints, rappel formule)
MAIL_FROM_ACTIVITY=activite@zennshop.com
MAIL_FROM_ACTIVITY_NAME=ZennShop

# ===== E-mail — transport SMTP (PRIORITAIRE sur Resend) =====
# Mot de passe d'application Google (16 caractères) ou serveur SMTP pro.
# ⚠️  Ne jamais committer un vrai mot de passe ici — utiliser les CI/CD secrets en prod.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=YOUR_GOOGLE_APP_PASSWORD

# (Optionnel) Comptes SMTP séparés par canal en production :
# EMAIL_SYSTEM_USER=compte@zennshop.com
# EMAIL_SYSTEM_PASSWORD=YOUR_SYSTEM_SMTP_PASSWORD
# EMAIL_ACTIVITY_USER=activite@zennshop.com
# EMAIL_ACTIVITY_PASSWORD=YOUR_ACTIVITY_SMTP_PASSWORD

# ===== Passerelle de Paiement PayDunya =====
# Mode: sandbox (développement/tests) ou live (production)
PAYDUNYA_ENVIRONMENT=sandbox
# ⚠️  OBLIGATOIRE même en sandbox : les 4 clés ci-dessous sont nécessaires pour
# initialiser les factures Checkout, et PAYDUNYA_MASTER_KEY sert à vérifier la
# signature SHA-512 des webhooks IPN (fail-closed).
# Récupérables dans le dashboard PayDunya → Intégrations → Clés API.
PAYDUNYA_MASTER_KEY=YOUR_PAYDUNYA_MASTER_KEY
PAYDUNYA_PUBLIC_KEY=YOUR_PAYDUNYA_PUBLIC_KEY
PAYDUNYA_PRIVATE_KEY=YOUR_PAYDUNYA_PRIVATE_KEY
PAYDUNYA_TOKEN=YOUR_PAYDUNYA_TOKEN
# URLs de redirection après le paiement et d'annulation
PAYDUNYA_CALLBACK_URL=http://localhost:3001/checkout/success
PAYDUNYA_CANCEL_URL=http://localhost:3001/checkout/cancel
# (Optionnel) URL publique du Webhook IPN (ex: https://api.zennshop.com/api/v1/payments/paydunya/webhook)
PAYDUNYA_IPN_URL=



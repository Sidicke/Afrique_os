# ===== API =====
PORT=3000
NODE_ENV=development

# ===== Base de données (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platforme?schema=public"

# ===== JWT =====
# Access token : courte durée (15 min), envoyé dans Authorization: Bearer
# 🔑 Générer en prod : openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token : longue durée (7 jours), stocké en cookie httpOnly
# 🔑 Générer en prod : openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN=7d
# Cookie refresh : Secure en production, SameSite strict, domaine éventuel
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ===== Chiffrement de la Messagerie (AES-256-GCM) =====
# ⚠️  OBLIGATOIRE — l'application refuse de démarrer si cette variable est absente.
# 🔑 Générer : openssl rand -hex 32
MESSAGING_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ===== Authentification Sociale (Google OAuth) =====
# ⚠️  OBLIGATOIRE si la connexion Google est activée dans le frontend.
# Obtenir sur : https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ===== CORS =====
# Origine autorisée du frontend Next.js (séparer plusieurs origines par des virgules)
CORS_ORIGINS=http://localhost:3001

# ===== Rate limiting (@nestjs/throttler) =====
# Limite globale par IP : ttl en millisecondes, limit = nombre de requêtes
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ===== E-mail transactionnel (Resend) =====
# Sans RESEND_API_KEY, le backend fonctionne en DRY-RUN (aucun e-mail envoyé,
# log en console) — pratique en dev et pour les tests.
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=
# Adresse d'expédition : doit être un domaine VÉRIFIÉ chez Resend
# (https://resend.com/domains). ⚠️ onboarding@resend.dev (mode test) ne livre
# que vers la boîte de votre compte Resend — jamais vers vos clients.
MAIL_FROM=noreply@votre-domaine.com
MAIL_FROM_NAME=Plateforme

# ===== E-mail — transport SMTP Gmail (PRIORITAIRE sur Resend) =====
# Mot de passe d'application Google (16 caractères) — jamais le mot de passe du compte.
# ⚠️  Ne jamais committer un vrai mot de passe ici — utiliser les CI/CD secrets en prod.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=YOUR_GOOGLE_APP_PASSWORD

# ===== Passerelle de Paiement FedaPay =====
# Mode: sandbox (développement/tests) ou live (production)
FEDAPAY_ENVIRONMENT=sandbox
# Clé secrète FedaPay (ex: sk_sandbox_... ou sk_live_...)
FEDAPAY_SECRET_KEY=YOUR_FEDAPAY_SECRET_KEY
# Clé publique FedaPay (ex: pk_sandbox_... ou pk_live_...)
FEDAPAY_PUBLIC_KEY=YOUR_FEDAPAY_PUBLIC_KEY
# Secret pour valider la signature des Webhooks FedaPay (x-fedapay-signature)
FEDAPAY_WEBHOOK_SECRET=YOUR_FEDAPAY_WEBHOOK_SECRET
# URL de redirection après le paiement
FEDAPAY_CALLBACK_URL=http://localhost:3001/checkout/success



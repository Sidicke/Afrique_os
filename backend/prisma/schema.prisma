generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  password             String?
  googleId             String?            @unique
  facebookId           String?            @unique
  authProvider         String?            @default("LOCAL")
  name                 String?
  phone                String?
  avatarUrl            String?
  role                 Role               @default(CLIENT)
  status               UserStatus         @default(ACTIVE)
  refreshTokenHash     String?
  defaultAddress       String?
  defaultCity          String?
  defaultPaymentMethod PaymentMethod?
  pointsBalance        Int                @default(0)
  referralCode         String?            @unique
  referredById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  adminLogs            AdminLog[]         @relation("AdminLogAuthor")
  adminNotes           AdminNote[]        @relation("AdminNoteAuthor")
  boutiques            Boutique[]
  conversations        Conversation[]     @relation("ConversationClient")
  messages             Message[]
  reportsSubmitted     ModerationReport[] @relation("ReportReporter")
  reportsResolved      ModerationReport[] @relation("ReportResolver")
  orders               Order[]
  settingsUpdates      PlatformSettings[] @relation("SettingsUpdater")
  pointTransactions    PointTransaction[]
  teamInvitations      TeamMember[]       @relation("TeamInviter")
  teamMemberships      TeamMember[]
  referredBy           User?              @relation("Referrals", fields: [referredById], references: [id])
  referees             User[]             @relation("Referrals")

  @@index([role])
}

model Boutique {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  slug                  String                 @unique
  tagline               String?
  description           String?
  status                BoutiqueStatus         @default(PENDING)
  verificationStatus    VerificationStatus     @default(NONE)
  plan                  String                 @default("starter")
  email                 String?
  phone                 String?
  city                  String?
  country               String?
  whatsappNumber        String?
  coverImage            String?
  logoImage             String?
  deliveryShortLabel    String?
  deliveryNote          String?
  warrantyNote          String?
  paymentNote           String?
  socialLinks           Json?
  deliveryPacks         Json?
  promotions            Json?
  notifications         Json?
  ownerId               String
  balance               Decimal                @default(0) @db.Decimal(14, 2)
  monthlyGoalFcfa       Decimal                @default(0) @db.Decimal(14, 2)
  fedapaySubAccountRef    String?
  fedapaySubAccountStatus String?                @default("NONE")
  fedapayCommissionRate   Decimal?               @db.Decimal(5, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brands                Brand[]
  categories            Category[]
  conversations         Conversation[]
  sellerNotifications   Notification[]
  orders                Order[]
  products              Product[]
  subscribers           Subscriber[]
  subscription          Subscription?
  teamMembers           TeamMember[]
  verificationDocuments VerificationDocument[]
  withdrawals           WithdrawalRequest[]

  @@index([ownerId])
  @@index([status])
}

model Brand {
  id         String    @id @default(cuid())
  name       String
  slug       String
  boutiqueId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId])
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String
  boutiqueId String
  parentId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  boutique   Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  oldPrice    Decimal?    @db.Decimal(12, 2)
  currency    String      @default("XOF")
  stock       Int         @default(0)
  sku         String?
  isFeatured  Boolean     @default(false)
  isActive    Boolean     @default(true)
  images      String[]
  boutiqueId  String
  categoryId  String?
  brandId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  boutique    Boutique    @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id])
  category    Category?   @relation(fields: [categoryId], references: [id])
  reviews     Review[]
  variants    Variant[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId, isActive])
  @@index([boutiqueId, categoryId])
  @@index([boutiqueId, price])
  @@index([isFeatured])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  name       String
  value      String
  priceDelta Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                 String        @id @default(cuid())
  reference          String        @unique
  boutiqueId         String
  userId             String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  address            String?
  city               String?
  country            String?
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod @default(MOBILE_MONEY)
  pointsUsed         Int           @default(0)
  paymentRef         String?
  paidAt             DateTime?
  cancellationReason String?
  deliveryName       String?
  deliveryPrice      Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  notes              String?
  commissionRate     Decimal?      @db.Decimal(5, 2)
  commissionAmount   Decimal?      @db.Decimal(12, 2)
  netAmount          Decimal?      @db.Decimal(12, 2)
  fedapayTransactionId String?
  fedapaySubAccountRef String?
  planAtPurchase     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deliveryContact    String?
  boutique           Boutique      @relation(fields: [boutiqueId], references: [id])
  user               User?         @relation(fields: [userId], references: [id])
  items              OrderItem[]

  @@index([boutiqueId, status])
  @@index([boutiqueId, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String
  variantLabel String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])
  variant      Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Conversation {
  id                 String    @id @default(cuid())
  boutiqueId         String
  userId             String?
  clientName         String
  clientPhone        String?
  lastMessageAt      DateTime  @default(now())
  productId          String?
  productName        String?
  productPrice       String?
  productDescription String?
  productImage       String?
  agreedPrice        Decimal?  @db.Decimal(14, 2)
  orderId            String?
  orderReference     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  boutique           Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  user               User?     @relation("ConversationClient", fields: [userId], references: [id])
  messages           Message[]

  @@index([boutiqueId])
  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderRole     MessageSender
  senderId       String?
  content        String
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String
  boutiqueId String
  createdAt  DateTime @default(now())
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, email])
  @@index([boutiqueId])
}

/// *
///  * Notification affichée au VENDEUR dans son dashboard (cloche) : créée côté
///  * serveur sur des événements métier (ex. annulation de commande par un client).
model Notification {
  id             String    @id @default(cuid())
  boutiqueId     String
  type           String
  title          String
  message        String?
  orderReference String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  boutique       Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId, readAt])
  @@index([boutiqueId, createdAt])
}

/// *
///  * Catalogue des formules d'abonnement (géré depuis le dashboard admin —
///  * PlansManager). Le champ `boutique.plan` reste la formule active du vendeur
///  * (cohérence : Subscription.plan.slug === boutique.plan).
model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  price         Decimal        @default(0) @db.Decimal(12, 2)
  interval      String         @default("month")
  features      Json?
  limits        Json?
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// *
///  * Abonnement réel d'une boutique (billing). Le statut TRIAL couvre l'essai
///  * gratuit ; le passage en ACTIVE se fait au premier paiement.
model Subscription {
  id                 String             @id @default(cuid())
  boutiqueId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  price              Decimal            @default(0) @db.Decimal(12, 2)
  startsAt           DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  boutique           Boutique           @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

/// *
///  * Signalement de modération : une cible (boutique, produit, utilisateur,
///  * commande, avis) signalée par un utilisateur ou détectée par la plateforme.
model ModerationReport {
  id             String               @id @default(cuid())
  targetType     ModerationTargetType
  targetId       String
  targetLabel    String?
  reason         String
  details        String?
  severity       String               @default("medium")
  status         ModerationStatus     @default(NEW)
  reporterId     String?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  reporter       User?                @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy     User?                @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// *
///  * Journal d'audit administratif (doc 20 : qui → quoi → quand → sur quoi →
///  * résultat). Chaque action importante du dashboard admin est tracée ici.
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  details     Json?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminLogAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

/// * Notes internes des administrateurs (liées à une cible)
model AdminNote {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  content    String
  adminId    String
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminNoteAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

/// * Documents fournis par un vendeur pour la vérification KYC
model VerificationDocument {
  id         String                   @id @default(cuid())
  boutiqueId String
  type       VerificationDocumentType
  label      String
  url        String
  status     String                   @default("pending")
  createdAt  DateTime                 @default(now())
  boutique   Boutique                 @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
}

/// *
///  * Code de vérification OTP (ex. validation de l'e-mail à l'inscription).
///  * Le code est stocké HASHÉ (SHA-256) avec une date d'expiration et un compteur
///  * de tentatives — jamais en clair.
model OtpCode {
  id         String    @id @default(cuid())
  identifier String
  purpose    String    @default("REGISTER")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

/// *
///  * Paramètres globaux de la plateforme (doc 11) — une seule ligne, le JSON
///  * suit la structure du dashboard admin (10 sections).
model PlatformSettings {
  id          String   @id @default("global")
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingsUpdater", fields: [updatedById], references: [id])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  boutiqueId  String
  amount      Decimal          @db.Decimal(14, 2)
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  paymentInfo String?
  boutique    Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
}

/// *
///   * Clés d'idempotence pour sécuriser les transactions financières (1er pilier de sécurité).
///   * Empêche les réexécutions accidentelles ou les Webhooks répétés.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([expiresAt])
}

/// *
///  * Membres d'équipe d'une boutique — invités par le propriétaire (Business+)
///  * Un collaborateur peut avoir accès à une ou plusieurs boutiques du même owner.
model TeamMember {
  id          String           @id @default(cuid())
  boutiqueId  String
  email       String
  name        String?
  role        TeamMemberRole   @default(EDITOR)
  status      TeamMemberStatus @default(PENDING)
  userId      String?
  invitedById String?
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  boutique    Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("TeamInviter", fields: [invitedById], references: [id])
  user        User?            @relation(fields: [userId], references: [id])

  @@unique([boutiqueId, email])
  @@index([boutiqueId])
  @@index([email])
}

enum Role {
  ADMIN
  VENDEUR
  CLIENT
}

enum BoutiqueStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  WHATSAPP_CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH_ON_DELIVERY
  CARD
  WHATSAPP_DIRECT
  FEDAPAY
}

enum MessageSender {
  CLIENT
  VENDEUR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ModerationStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ModerationTargetType {
  BOUTIQUE
  PRODUCT
  USER
  ORDER
  REVIEW
}

enum VerificationDocumentType {
  IDENTITY
  REGISTRE
  LICENCE
  PHOTO_BOUTIQUE
  ADDRESS
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamMemberRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

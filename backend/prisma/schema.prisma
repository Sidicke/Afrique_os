  READY_FOR_DISPATCH
  AWAITING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  HANDOVER_PENDING
  ARRIVED_AT_STATION
  PICKUP_CONFIRMATION_PENDING
  DELIVERY_PENDING_VERIFICATION
  DELIVERED_VERIFIED
  BUYER_ACCEPTED
  FAILED_ATTEMPT
  RETURNING
  RETURNED
  LOST
  CANCELLED
  UNDER_REVIEW
}

enum DispatchMode {
  SELLER_PERSONAL_COURIER
  PARTNER_AGENCY
  PUBLIC_POOL
}

enum DeliveryLegType {
  COLLECTION
  INTERURBAN_TRANSIT
  LAST_MILE
  STATION_PICKUP
  DIRECT_LOCAL
}

enum DeliveryLegStatus {
  PLANNED
  AWAITING_ASSIGNMENT
  ASSIGNED
  IN_PROGRESS
  HANDOVER_DECLARED
  ARRIVED_AT_STATION
  COMPLETED
  FAILED
  CANCELLED

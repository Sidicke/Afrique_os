generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  password             String?
  googleId             String?            @unique
  facebookId           String?            @unique
  authProvider         String?            @default("LOCAL")
  name                 String?
  phone                String?
  avatarUrl            String?
  role                 Role               @default(CLIENT)
  status               UserStatus         @default(ACTIVE)
  refreshTokenHash     String?
  defaultAddress       String?
  defaultCity          String?
  defaultPaymentMethod PaymentMethod?
  pointsBalance        Int                @default(0)
  referralCode         String?            @unique
  referredById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  adminLogs            AdminLog[]         @relation("AdminLogAuthor")
  adminNotes           AdminNote[]        @relation("AdminNoteAuthor")
  boutiques            Boutique[]
  conversations        Conversation[]     @relation("ConversationClient")
  messages             Message[]
  reportsSubmitted     ModerationReport[] @relation("ReportReporter")
  reportsResolved      ModerationReport[] @relation("ReportResolver")
  orders               Order[]
  settingsUpdates      PlatformSettings[] @relation("SettingsUpdater")
  pointTransactions    PointTransaction[]
  refundRequests       RefundRequest[]
  teamInvitations      TeamMember[]       @relation("TeamInviter")
  teamMemberships      TeamMember[]
  referredBy           User?              @relation("Referrals", fields: [referredById], references: [id])
  referees             User[]             @relation("Referrals")
  courierProfile       CourierProfile?
  ownedAgencies        DeliveryAgency[]   @relation("AgencyOwner")
  addressSnapshots     AddressSnapshot[]
  customerShipments    Shipment[]         @relation("ShipmentCustomer")
  courierConversations Conversation[]     @relation("ConversationCourier")
  deliveryDisputes     DeliveryDispute[]  @relation("DisputeOpener")

  @@index([role])
}

model Boutique {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  slug                  String                 @unique
  tagline               String?
  description           String?
  status                BoutiqueStatus         @default(PENDING)
  verificationStatus    VerificationStatus     @default(NONE)
  plan                  String                 @default("starter")
  email                 String?
  phone                 String?
  city                  String?
  country               String?
  whatsappNumber        String?
  coverImage            String?
  logoImage             String?
  deliveryShortLabel    String?
  deliveryNote          String?
  warrantyNote          String?
  paymentNote           String?
  socialLinks           Json?
  deliveryPacks         Json?
  promotions            Json?
  notifications         Json?
  ownerId               String
  balance               Decimal                @default(0) @db.Decimal(14, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  monthlyGoalFcfa       Decimal                @default(0) @db.Decimal(14, 2)
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  brands                Brand[]
  categories            Category[]
  conversations         Conversation[]
  sellerNotifications   Notification[]
  orders                Order[]
  products              Product[]
  refundRequests        RefundRequest[]
  subscribers           Subscriber[]
  subscription          Subscription?
  teamMembers           TeamMember[]
  verificationDocuments VerificationDocument[]
  withdrawals           WithdrawalRequest[]
  shipments             Shipment[]
  deliveryMissions      DeliveryMission[]
  deliveryDisputes      DeliveryDispute[]

  @@index([ownerId])
  @@index([status])
}

model Brand {
  id         String    @id @default(cuid())
  name       String
  slug       String
  boutiqueId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  boutique   Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId])
}

model Category {
  id         String     @id @default(cuid())
  name       String
  slug       String
  boutiqueId String
  parentId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  boutique   Boutique   @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  oldPrice    Decimal?    @db.Decimal(12, 2)
  currency    String      @default("XOF")
  stock       Int         @default(0)
  sku         String?
  isFeatured  Boolean     @default(false)
  isActive    Boolean     @default(true)
  images      String[]
  boutiqueId  String
  categoryId  String?
  brandId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  boutique    Boutique    @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id])
  category    Category?   @relation(fields: [categoryId], references: [id])
  reviews     Review[]
  variants    Variant[]

  @@unique([boutiqueId, slug])
  @@index([boutiqueId, isActive])
  @@index([boutiqueId, categoryId])
  @@index([boutiqueId, price])
  @@index([isFeatured])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  name       String
  value      String
  priceDelta Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                 String         @id @default(cuid())
  reference          String         @unique
  boutiqueId         String
  userId             String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  address            String?
  city               String?
  country            String?
  status             OrderStatus    @default(PENDING)
  paymentMethod      PaymentMethod  @default(MOBILE_MONEY)
  pointsUsed         Int            @default(0)
  paymentRef         String?
  paidAt             DateTime?
  cancellationReason String?
  deliveryName       String?
  deliveryPrice      Decimal        @default(0) @db.Decimal(12, 2)
  total              Decimal        @db.Decimal(12, 2)
  notes              String?
  commissionRate     Decimal?       @db.Decimal(5, 2)
  commissionAmount   Decimal?       @db.Decimal(12, 2)
  netAmount          Decimal?       @db.Decimal(12, 2)
  planAtPurchase     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deliveryContact    String?
  boutique           Boutique       @relation(fields: [boutiqueId], references: [id])
  user               User?          @relation(fields: [userId], references: [id])
  items              OrderItem[]
  refundRequest      RefundRequest?
  shipments          Shipment[]
  settlements        SettlementAllocation[]
  deliveryDisputes   DeliveryDispute[]

  @@index([boutiqueId, status])
  @@index([boutiqueId, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String
  variantLabel String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])
  variant      Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Conversation {
  id                 String    @id @default(cuid())
  boutiqueId         String
  userId             String?
  clientName         String
  clientPhone        String?
  lastMessageAt      DateTime  @default(now())
  productId          String?
  productName        String?
  productPrice       String?
  productDescription String?
  productImage       String?
  agreedPrice        Decimal?  @db.Decimal(14, 2)
  orderId            String?
  orderReference     String?
  courierUserId      String?
  channelType        String    @default("SELLER_CLIENT")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  boutique           Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  user               User?     @relation("ConversationClient", fields: [userId], references: [id])
  courierUser        User?     @relation("ConversationCourier", fields: [courierUserId], references: [id])
  messages           Message[]
  shipmentAccesses   ShipmentConversationAccess[]

  @@index([boutiqueId])
  @@index([userId])
  @@index([courierUserId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderRole     MessageSender
  senderId       String?
  content        String
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String
  boutiqueId String
  createdAt  DateTime @default(now())
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@unique([boutiqueId, email])
  @@index([boutiqueId])
}

/// *
/// * Notification affichée au VENDEUR dans son dashboard (cloche) : créée côté
/// * serveur sur des événements métier (ex. annulation de commande par un client).
model Notification {
  id             String    @id @default(cuid())
  boutiqueId     String
  type           String
  title          String
  message        String?
  orderReference String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  boutique       Boutique  @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId, readAt])
  @@index([boutiqueId, createdAt])
}

/// *
/// * Catalogue des formules d'abonnement (géré depuis le dashboard admin —
/// * PlansManager). Le champ `boutique.plan` reste la formule active du vendeur
/// * (cohérence : Subscription.plan.slug === boutique.plan).
model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  price         Decimal        @default(0) @db.Decimal(12, 2)
  interval      String         @default("month")
  features      Json?
  limits        Json?
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// *
/// * Abonnement réel d'une boutique (billing). Le statut TRIAL couvre l'essai
/// * gratuit ; le passage en ACTIVE se fait au premier paiement.
model Subscription {
  id                 String             @id @default(cuid())
  boutiqueId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  price              Decimal            @default(0) @db.Decimal(12, 2)
  startsAt           DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  boutique           Boutique           @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

/// *
/// * Signalement de modération : une cible (boutique, produit, utilisateur,
/// * commande, avis) signalée par un utilisateur ou détectée par la plateforme.
model ModerationReport {
  id             String               @id @default(cuid())
  targetType     ModerationTargetType
  targetId       String
  targetLabel    String?
  reason         String
  details        String?
  severity       String               @default("medium")
  status         ModerationStatus     @default(NEW)
  reporterId     String?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  reporter       User?                @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy     User?                @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// *
/// * Journal d'audit administratif (doc 20 : qui → quoi → quand → sur quoi →
/// * résultat). Chaque action importante du dashboard admin est tracée ici.
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  details     Json?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminLogAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

/// * Notes internes des administrateurs (liées à une cible)
model AdminNote {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  content    String
  adminId    String
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminNoteAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

/// * Documents fournis par un vendeur pour la vérification KYC
model VerificationDocument {
  id         String                   @id @default(cuid())
  boutiqueId String
  type       VerificationDocumentType
  label      String
  url        String
  status     String                   @default("pending")
  createdAt  DateTime                 @default(now())
  boutique   Boutique                 @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
}

/// *
/// * Code de vérification OTP (ex. validation de l'e-mail à l'inscription).
/// * Le code est stocké HASHÉ (SHA-256) avec une date d'expiration et un compteur
/// * de tentatives — jamais en clair.
model OtpCode {
  id         String    @id @default(cuid())
  identifier String
  purpose    String    @default("REGISTER")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

/// *
/// * Paramètres globaux de la plateforme (doc 11) — une seule ligne, le JSON
/// * suit la structure du dashboard admin (10 sections).
model PlatformSettings {
  id          String   @id @default("global")
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingsUpdater", fields: [updatedById], references: [id])
}

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  boutiqueId  String
  amount      Decimal          @db.Decimal(14, 2)
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  processedAt DateTime?
  paymentInfo String?
  boutique    Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
}

/// *
/// * Clés d'idempotence pour sécuriser les transactions financières (1er pilier de sécurité).
/// * Empêche les réexécutions accidentelles ou les Webhooks répétés.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([expiresAt])
}

/// *
/// * Membres d'équipe d'une boutique — invités par le propriétaire (Business+)
/// * Un collaborateur peut avoir accès à une ou plusieurs boutiques du même owner.
model TeamMember {
  id          String           @id @default(cuid())
  boutiqueId  String
  email       String
  name        String?
  role        TeamMemberRole   @default(EDITOR)
  status      TeamMemberStatus @default(PENDING)
  userId      String?
  invitedById String?
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  boutique    Boutique         @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("TeamInviter", fields: [invitedById], references: [id])
  user        User?            @relation(fields: [userId], references: [id])

  @@unique([boutiqueId, email])
  @@index([boutiqueId])
  @@index([email])
}

model RefundRequest {
  id              String       @id @default(cuid())
  orderId         String       @unique
  clientId        String
  boutiqueId      String
  reason          String
  description     String?
  evidenceUrl     String?
  vendorComment   String?
  vendorRepliedAt DateTime?
  status          RefundStatus @default(PENDING)
  adminNotes      String?
  resolutionText  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  boutique        Boutique     @relation(fields: [boutiqueId], references: [id])
  client          User         @relation(fields: [clientId], references: [id])
  order           Order        @relation(fields: [orderId], references: [id])
}

enum Role {
  ADMIN
  VENDEUR
  CLIENT
}

enum BoutiqueStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  WHATSAPP_CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MOBILE_MONEY
  CASH_ON_DELIVERY
  CARD
  WHATSAPP_DIRECT
  PAYDUNYA
}

enum MessageSender {
  CLIENT
  VENDEUR
  LIVREUR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ModerationStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ModerationTargetType {
  BOUTIQUE
  PRODUCT
  USER
  ORDER
  REVIEW
}

enum VerificationDocumentType {
  IDENTITY
  REGISTRE
  LICENCE
  PHOTO_BOUTIQUE
  ADDRESS
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamMemberRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum RefundStatus {
  PENDING
  VENDOR_REPLIED
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED
}

// ============================================================================
// EXTENSION SYSTÈME DE LIVRAISON ZENNSHOP (BÉNIN : LOCAL, AGENCE, INTERURBAIN)
// ============================================================================

model DeliveryZone {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  department       String
  commune          String
  arrondissement   String?
  quartier         String?
  zoneType         DeliveryZoneType   @default(URBAN)
  latitude         Float?
  longitude        Float?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  stations         Station[]
  originRules      DeliveryRateRule[] @relation("OriginZoneRate")
  destinationRules DeliveryRateRule[] @relation("DestinationZoneRate")

  @@index([department, commune])
  @@index([isActive])
}

model Station {
  id                  String        @id @default(cuid())
  code                String        @unique
  name                String
  carrierCompany      String
  department          String
  commune             String
  quartier            String?
  address             String?
  landmark            String?
  contactPhone        String?
  openingHours        String?
  latitude            Float?
  longitude           Float?
  zoneId              String?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  zone                DeliveryZone? @relation(fields: [zoneId], references: [id])
  destinationShipments Shipment[]   @relation("ShipmentDestinationStation")
  originLegs          DeliveryLeg[] @relation("LegOriginStation")
  destinationLegs     DeliveryLeg[] @relation("LegDestinationStation")

  @@index([department, commune])
  @@index([isActive])
}

model DeliveryRateRule {
  id                String           @id @default(cuid())
  name              String
  originZoneId      String?
  destinationZoneId String?
  deliveryMode      DeliveryMode     @default(HOME)
  packageSize       PackageSize      @default(STANDARD)
  basePriceFcfa     Decimal          @db.Decimal(12, 2)
  agencyFeeSharePct Decimal          @default(90) @db.Decimal(5, 2)
  estimatedMinHours Int              @default(2)
  estimatedMaxHours Int              @default(24)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  originZone        DeliveryZone?    @relation("OriginZoneRate", fields: [originZoneId], references: [id])
  destinationZone   DeliveryZone?    @relation("DestinationZoneRate", fields: [destinationZoneId], references: [id])

  @@index([originZoneId, destinationZoneId, deliveryMode])
  @@index([isActive])
}

model AddressSnapshot {
  id                   String                 @id @default(cuid())
  userId               String?
  country              String                 @default("Bénin")
  department           String
  commune              String
  arrondissement       String?
  quartier             String
  streetOrLandmark     String
  deliveryInstructions String?
  recipientName        String?
  contactPhone         String
  secondaryPhone       String?
  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?
  locationSource       AddressLocationSource  @default(MANUAL_APPROXIMATE)
  precisionLevel       AddressPrecisionLevel  @default(LANDMARK_TEXT)
  confirmedByCustomer  Boolean                @default(true)
  createdAt            DateTime               @default(now())
  user                 User?                  @relation(fields: [userId], references: [id])
  originShipments      Shipment[]             @relation("ShipmentOriginAddress")
  destinationShipments Shipment[]             @relation("ShipmentDestinationAddress")
  originLegs           DeliveryLeg[]          @relation("LegOriginAddress")
  destinationLegs      DeliveryLeg[]          @relation("LegDestinationAddress")

  @@index([userId])
  @@index([department, commune])
}

model DeliveryAgency {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  ownerId             String
  phone               String
  whatsappNumber      String?
  email               String?
  department          String               @default("Littoral")
  commune             String               @default("Cotonou")
  address             String?
  description         String?
  logoUrl             String?
  rccmNumber          String?
  ifuNumber           String?
  idDocumentUrl       String?
  verificationStatus  VerificationStatus   @default(PENDING)
  status              AgencyStatus         @default(PENDING)
  coveredCommunes     String[]
  supportsInterurban  Boolean              @default(false)
  baseRateFcfa        Decimal              @default(1000) @db.Decimal(12, 2)
  balance             Decimal              @default(0) @db.Decimal(14, 2)
  pendingBalance      Decimal              @default(0) @db.Decimal(14, 2)
  rating              Float                @default(5.0)
  completedDeliveries Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User                 @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships         AgencyMembership[]
  activeCouriers      CourierProfile[]     @relation("CourierActiveAgency")
  shipments           Shipment[]
  missions            DeliveryMission[]

  @@index([ownerId])
  @@index([status, verificationStatus])
}

model CourierProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  courierType        CourierType          @default(INDEPENDENT)
  displayName        String
  phone              String
  whatsappNumber     String?
  department         String               @default("Littoral")
  commune            String               @default("Cotonou")
  vehicleType        VehicleType          @default(MOTO)
  plateNumber        String?
  idDocumentType     String?
  idDocumentNumber   String?
  idDocumentUrl      String?
  selfieUrl          String?
  verificationStatus VerificationStatus   @default(PENDING)
  status             CourierStatus        @default(PENDING)
  isAvailable        Boolean              @default(true)
  coveredCommunes    String[]
  activeAgencyId     String?
  balance            Decimal              @default(0) @db.Decimal(14, 2)
  pendingBalance     Decimal              @default(0) @db.Decimal(14, 2)
  rating             Float                @default(5.0)
  completedMissions  Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeAgency       DeliveryAgency?      @relation("CourierActiveAgency", fields: [activeAgencyId], references: [id])
  memberships        AgencyMembership[]
  assignedShipments  Shipment[]           @relation("ShipmentAssignedCourier")
  assignedMissions   DeliveryMission[]    @relation("MissionAssignedCourier")
  requestedMissions  DeliveryMission[]    @relation("MissionRequestedCourier")

  @@index([courierType, verificationStatus, status])
  @@index([activeAgencyId])
}

model AgencyMembership {
  id                      String                 @id @default(cuid())
  agencyId                String
  courierProfileId        String
  status                  AgencyMembershipStatus @default(PENDING)
  role                    String                 @default("COURIER")
  canBeRequestedBySeller  Boolean                @default(true)
  invitedByUserId         String?
  joinedAt                DateTime?
  detachedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  agency                  DeliveryAgency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  courierProfile          CourierProfile         @relation(fields: [courierProfileId], references: [id], onDelete: Cascade)

  @@unique([agencyId, courierProfileId])
  @@index([courierProfileId, status])
  @@index([agencyId, status])
}

model Shipment {
  id                      String                        @id @default(cuid())
  reference               String                        @unique
  orderId                 String
  boutiqueId              String
  customerUserId          String?
  status                  ShipmentStatus                @default(AWAITING_PREPARATION)
  deliveryMode            DeliveryMode                  @default(HOME)
  dispatchMode            DispatchMode?
  originAddressId         String?
  destinationAddressId    String?
  destinationStationId    String?
  packageCategory         PackageSize                   @default(STANDARD)
  packageDescription      String?
  declaredValueFcfa       Decimal                       @default(0) @db.Decimal(12, 2)
  isFragile               Boolean                       @default(false)
  quotedFeeFcfa           Decimal                       @default(0) @db.Decimal(12, 2)
  chargedToBuyerFcfa      Decimal                       @default(0) @db.Decimal(12, 2)
  sellerSubsidyFcfa       Decimal                       @default(0) @db.Decimal(12, 2)
  isFeeIncludedInPack     Boolean                       @default(false)
  deliveryCodeHash        String?
  deliveryCodeCipher      String?
  deliveryCodeExpiresAt   DateTime?
  deliveryCodeAttempts    Int                           @default(0)
  deliveryCodeLockedUntil DateTime?
  guestTrackingTokenHash  String?
  assignedAgencyId        String?
  assignedCourierId       String?
  personalCourierName     String?
  personalCourierPhone    String?
  dispatchedAt            DateTime?
  pickedUpAt              DateTime?
  arrivedAtStationAt      DateTime?
  deliveredVerifiedAt     DateTime?
  conformityDeadlineAt    DateTime?
  buyerAcceptedAt         DateTime?
  cancelledAt             DateTime?
  cancellationReason      String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  order                   Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  boutique                Boutique                      @relation(fields: [boutiqueId], references: [id])
  customer                User?                         @relation("ShipmentCustomer", fields: [customerUserId], references: [id])
  originAddress           AddressSnapshot?              @relation("ShipmentOriginAddress", fields: [originAddressId], references: [id])
  destinationAddress      AddressSnapshot?              @relation("ShipmentDestinationAddress", fields: [destinationAddressId], references: [id])
  destinationStation      Station?                      @relation("ShipmentDestinationStation", fields: [destinationStationId], references: [id])
  assignedAgency          DeliveryAgency?               @relation(fields: [assignedAgencyId], references: [id])
  assignedCourier         CourierProfile?               @relation("ShipmentAssignedCourier", fields: [assignedCourierId], references: [id])
  legs                    DeliveryLeg[]
  missions                DeliveryMission[]
  evidences               HandoverEvidence[]
  events                  DeliveryEvent[]
  conversationAccesses    ShipmentConversationAccess[]
  settlements             SettlementAllocation[]
  disputes                DeliveryDispute[]

  @@index([orderId])
  @@index([boutiqueId, status])
  @@index([customerUserId])
  @@index([assignedCourierId])
  @@index([assignedAgencyId])
}

model DeliveryLeg {
  id                  String             @id @default(cuid())
  shipmentId          String
  sequence            Int                @default(1)
  legType             DeliveryLegType    @default(DIRECT_LOCAL)
  status              DeliveryLegStatus  @default(PLANNED)
  originAddressId     String?
  destinationAddressId String?
  originStationId     String?
  destinationStationId String?
  carrierCompany      String?
  carrierTicketRef    String?
  carrierContactPhone String?
  driverName          String?
  vehicleIdentifier   String?
  departureTime       DateTime?
  estimatedArrivalAt  DateTime?
  actualArrivalAt     DateTime?
  agreedFeeFcfa       Decimal            @default(0) @db.Decimal(12, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  shipment            Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  originAddress       AddressSnapshot?   @relation("LegOriginAddress", fields: [originAddressId], references: [id])
  destinationAddress  AddressSnapshot?   @relation("LegDestinationAddress", fields: [destinationAddressId], references: [id])
  originStation       Station?           @relation("LegOriginStation", fields: [originStationId], references: [id])
  destinationStation  Station?           @relation("LegDestinationStation", fields: [destinationStationId], references: [id])
  missions            DeliveryMission[]
  evidences           HandoverEvidence[]
  events              DeliveryEvent[]

  @@unique([shipmentId, sequence])
  @@index([shipmentId, status])
}

model DeliveryMission {
  id                        String                        @id @default(cuid())
  reference                 String                        @unique
  shipmentId                String
  legId                     String?
  boutiqueId                String
  missionMode               DispatchMode                  @default(PUBLIC_POOL)
  status                    DeliveryMissionStatus         @default(OFFERED)
  agencyId                  String?
  courierProfileId          String?
  requestedCourierProfileId String?
  agencyApprovedPreferred   Boolean?
  agreedFeeFcfa             Decimal                       @default(0) @db.Decimal(12, 2)
  appliedCommissionRatePct  Decimal                       @default(10) @db.Decimal(5, 2)
  platformCommissionFcfa    Decimal                       @default(0) @db.Decimal(12, 2)
  netCourierPayoutFcfa      Decimal                       @default(0) @db.Decimal(12, 2)
  isExternalSellerPayment   Boolean                       @default(false)
  originSummary             String?
  destinationSummary        String?
  reservedUntil             DateTime?
  expiresAt                 DateTime?
  acceptedAt                DateTime?
  pickedUpAt                DateTime?
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  shipment                  Shipment                      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg                       DeliveryLeg?                  @relation(fields: [legId], references: [id])
  boutique                  Boutique                      @relation(fields: [boutiqueId], references: [id])
  agency                    DeliveryAgency?               @relation(fields: [agencyId], references: [id])
  courierProfile            CourierProfile?               @relation("MissionAssignedCourier", fields: [courierProfileId], references: [id])
  requestedCourierProfile   CourierProfile?               @relation("MissionRequestedCourier", fields: [requestedCourierProfileId], references: [id])
  evidences                 HandoverEvidence[]
  events                    DeliveryEvent[]
  conversationAccesses      ShipmentConversationAccess[]
  settlements               SettlementAllocation[]

  @@index([status, missionMode])
  @@index([shipmentId])
  @@index([courierProfileId, status])
  @@index([agencyId, status])
}

model HandoverEvidence {
  id                 String             @id @default(cuid())
  shipmentId         String
  legId              String?
  missionId          String?
  step               HandoverStep
  actorUserId        String?
  actorRole          String
  verificationMethod VerificationMethod @default(PHOTO_DECLARATION)
  codeVerified       Boolean            @default(false)
  receiptReference   String?
  carrierCompany     String?
  driverPhone        String?
  photoUrl           String?
  signatureData      String?
  gpsLatitude        Float?
  gpsLongitude       Float?
  gpsAccuracyMeters  Float?
  notes              String?
  status             EvidenceStatus     @default(DECLARED)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  shipment           Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg                DeliveryLeg?       @relation(fields: [legId], references: [id])
  mission            DeliveryMission?   @relation(fields: [missionId], references: [id])

  @@index([shipmentId, step])
  @@index([missionId])
}

model DeliveryEvent {
  id          String           @id @default(cuid())
  shipmentId  String
  legId       String?
  missionId   String?
  actorId     String?
  actorRole   String
  eventType   String
  oldStatus   String?
  newStatus   String?
  description String?
  payload     Json?
  createdAt   DateTime         @default(now())
  shipment    Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg         DeliveryLeg?     @relation(fields: [legId], references: [id])
  mission     DeliveryMission? @relation(fields: [missionId], references: [id])

  @@index([shipmentId, createdAt])
}

model ShipmentConversationAccess {
  id             String                   @id @default(cuid())
  conversationId String
  shipmentId     String
  missionId      String
  customerUserId String?
  courierUserId  String
  status         ConversationAccessStatus @default(ACTIVE)
  activatedAt    DateTime                 @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shipment       Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  mission        DeliveryMission          @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, conversationId])
  @@index([conversationId, status])
  @@index([shipmentId, status])
  @@index([courierUserId, status])
}

model SettlementAllocation {
  id                   String                    @id @default(cuid())
  orderId              String
  shipmentId           String?
  missionId            String?
  beneficiaryType      SettlementBeneficiaryType
  beneficiaryId        String
  grossAmountFcfa      Decimal                   @db.Decimal(14, 2)
  commissionRate       Decimal                   @default(0) @db.Decimal(5, 2)
  commissionAmountFcfa Decimal                   @default(0) @db.Decimal(14, 2)
  netAmountFcfa        Decimal                   @db.Decimal(14, 2)
  status               SettlementStatus          @default(PENDING_PAYMENT)
  holdReason           String?
  eligibleForReleaseAt DateTime?
  releasedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  order                Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment             Shipment?                 @relation(fields: [shipmentId], references: [id])
  mission              DeliveryMission?          @relation(fields: [missionId], references: [id])

  @@index([orderId, beneficiaryType])
  @@index([shipmentId])
  @@index([beneficiaryId, status])
}

model DeliveryDispute {
  id                       String                @id @default(cuid())
  reference                String                @unique
  shipmentId               String
  orderId                  String
  boutiqueId               String
  openedByUserId           String?
  disputeScope             DisputeScope          @default(BOTH)
  reason                   String
  description              String
  evidenceUrls             String[]
  status                   DeliveryDisputeStatus @default(OPEN)
  sellerAllocationFrozen   Boolean               @default(false)
  deliveryAllocationFrozen Boolean               @default(false)
  adminNotes               String?
  resolutionSummary        String?
  resolvedByUserId         String?
  resolvedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  shipment                 Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order                    Order                 @relation(fields: [orderId], references: [id])
  boutique                 Boutique              @relation(fields: [boutiqueId], references: [id])
  openedBy                 User?                 @relation("DisputeOpener", fields: [openedByUserId], references: [id])

  @@index([shipmentId])
  @@index([orderId])
  @@index([status])
}

enum DeliveryZoneType {
  URBAN
  PERIURBAN
  INTERURBAN
}

enum DeliveryMode {
  HOME
  STATION_PICKUP
  INTERURBAN_STATION
  INTERURBAN_HOME
  SELLER_SELF
}

enum PackageSize {
  SMALL

  LARGE
  FRAGILE
}

enum AddressLocationSource {
  GPS_CONFIRMED
  OSM_PIN
  MANUAL_APPROXIMATE
}

enum AddressPrecisionLevel {
  EXACT_GPS
  PIN_CONFIRMED
  LANDMARK_TEXT
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CourierType {
  INDEPENDENT
  AGENCY_MEMBER
}

enum CourierStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum VehicleType {
